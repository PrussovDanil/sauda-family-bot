# Copy to .env and replace this placeholder locally. Never commit a real token.
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token

# Comma-separated Telegram user IDs allowed to use the bot. Empty means nobody.
TELEGRAM_ALLOWED_USER_IDS=123456789

# SQLite runtime database. Tests override this with an in-memory database.
SQLITE_DATABASE_PATH=./data/sauda-family-bot.sqlite

# Optional, paid analysis. Keep disabled until the API key and model are set.
OPENAI_ANALYSIS_ENABLED=false
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-6-astra

# Sauda uses https://sauda.e-qazyna.kz and the repository's existing TLS CA setup.
